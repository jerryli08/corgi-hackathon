# Copy to .env and fill in what you need. Everything has a working default, so an
# empty .env still boots -- in mock mode, with the colour vision backend, the keyword
# router, and texts printed to the console instead of sent.

# --- Mode ---------------------------------------------------------------
CORGI_MOCK=1                       # 1 = simulated robot + synthetic camera, 0 = hardware
CORGI_HOST=0.0.0.0
CORGI_PORT=8000

# --- Drive base ---------------------------------------------------------
CORGI_DRIVE_PORT=                  # blank = autodetect the Arduino
CORGI_DRIVE_BAUD=115200
CORGI_MAX_LINEAR=0.25              # m/s
CORGI_MAX_ANGULAR=1.2              # rad/s
CORGI_FIRMWARE_WATCHDOG_MS=1500

# --- Arm (SO-101) -------------------------------------------------------
CORGI_ARM_ENABLED=0                # 0 = drive-only: escort the item, don't lift it
CORGI_SERVO_PORT=/dev/tty.usbmodem58FA0960681
CORGI_GRIPPER_EMPTY_DEG=4.0        # gripper travel past this on a close = empty jaws

# --- Camera -------------------------------------------------------------
CORGI_CAMERA_ENABLED=1
CORGI_CAMERA_INDEX=0

# --- Vision -------------------------------------------------------------
CORGI_VISION_BACKEND=color         # color = offline, works against the sim; vlm = demo path
CORGI_VLM_PROVIDER=gemini          # gemini | openai | anthropic
CORGI_VLM_MODEL=                   # blank = provider default
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- The two numbers that matter ----------------------------------------
# Where an object must appear in frame for the canned grasp to work.
# Get them from: python scripts/calibrate.py <item>
CORGI_SWEET_SPOT_X=0.50
CORGI_SWEET_SPOT_H=0.34

# --- Messaging (Photon / iMessage) --------------------------------------
# log         = print texts to the console. The default, and what the tests use.
# photon      = Photon Spectrum, through the corgi/ bridge (bun create spectrum-project).
#               See the "Texting it for real" section of README.md.
# applescript = the Messages app on this Mac. No account and no keys, but it cannot
#               receive -- inbound still needs the bridge, the webhook, or the browser.
CORGI_MESSAGING_BACKEND=log
CORGI_PHOTON_BRIDGE_URL=http://127.0.0.1:8787
CORGI_PHOTON_BRIDGE_TIMEOUT_S=6.0
# Only matters if you set the same value in corgi/'s environment. Blank skips the
# check -- the bridge only ever binds loopback, so this is a second lock, not the door.
CORGI_BRIDGE_SECRET=
# Only needed for a public Photon Cloud webhook, an alternative to the corgi/ bridge.
# Shown once, when you register the webhook. Without it the webhook rejects everything.
CORGI_PHOTON_WEBHOOK_SECRET=
CORGI_PHOTON_REQUIRE_SIGNATURE=1
CORGI_PHOTON_WEBHOOK_TOLERANCE_S=300
# Blank = answer anyone. Otherwise a comma-separated allowlist of E.164 numbers.
CORGI_ALLOWED_SENDERS=
CORGI_DAILY_MESSAGE_BUDGET=200
CORGI_TEXT_MIN_GAP_S=6.0
CORGI_ALLOW_SIMULATED_TEXTS=1

# --- Router (Merge Gateway) ---------------------------------------------
# keyword = deterministic and offline, and the fallback for every merge failure.
# merge   = Merge Gateway, routing across providers underneath us.
CORGI_ROUTER_BACKEND=keyword
CORGI_MERGE_BASE_URL=https://api-gateway.merge.dev/v1
# responses = the merge_gateway SDK's native call (pip install merge-gateway-python)
# openai    = the OpenAI-compatible shim over plain REST, no SDK dependency
CORGI_MERGE_API=responses
MERGE_API_KEY=
# Catalogue ids move. `python scripts/check_router.py` prints what your key can reach.
CORGI_ROUTER_FAST_MODEL=anthropic/claude-haiku-4-5-20251001
CORGI_ROUTER_DEEP_MODEL=anthropic/claude-sonnet-5
CORGI_ROUTER_TIMEOUT_S=8.0
CORGI_ROUTER_CONFIDENCE_FLOOR=0.65
CORGI_ROUTER_MAX_CHARS=600

# --- Coming to a person -------------------------------------------------
CORGI_COME_SWEET_SPOT_H=0.62       # stop further out than a grasp: beside them, not on them
CORGI_COME_TOL_H=0.06
CORGI_PERSON_LABEL=person
CORGI_PERSON_MIN_ASPECT=1.15       # taller than wide, or it is furniture

# --- Walking alongside someone -----------------------------------------
# NOT a mobility aid and NOT load-bearing. Half speed, because the point is to be
# predictable next to someone unsteady.
CORGI_WALK_LINEAR=0.12             # m/s
CORGI_WALK_ANGULAR=0.5             # rad/s
CORGI_WALK_STEP_MS=250
CORGI_WALK_DEADMAN_MS=1200         # wheels move only while instructions keep arriving
CORGI_WALK_MAX_S=300.0
CORGI_WALK_RECHECK_STEPS=12

# --- Basket -------------------------------------------------------------
CORGI_BASKET_CAPACITY=3

# --- Delivery -----------------------------------------------------------
CORGI_HOME_TAG_ID=0
CORGI_DELIVER_SWEET_SPOT_H=0.45

# --- Fine tuning --------------------------------------------------------
# You should not need these. They are here so this file really is the full list, and
# so nobody has to read robot/config.py to find out what is adjustable.
CORGI_FULL_SCALE_US=300            # pulse offset from stop at full commanded speed
CORGI_DEFAULT_SPEED_US=120
CORGI_WHEEL_BASE_M=0.22
CORGI_WATCHDOG_GRACE_MS=200        # host stops the wheels this long after a command lapses
CORGI_SERVO_BAUD=1000000
CORGI_STREAM_FPS=12
CORGI_VLM_TIMEOUT_S=8.0
CORGI_TOL_X=0.035                  # how close to the sweet spot counts as lined up
CORGI_TOL_H=0.03
CORGI_K_ANGULAR=1.6                # proportional gains for the move-then-look loop
CORGI_K_LINEAR=1.2
CORGI_STEP_MS=300                  # one drive step between two looks
CORGI_MAX_SERVO_STEPS=40
CORGI_SEARCH_STEP_RAD=0.35         # how far to rotate per look while searching
CORGI_MAX_SEARCH_STEPS=24
